# Copy this file to `.env` (or export these as real environment variables /
# secrets in your deployment platform) and fill in real values. Never commit
# an actual `.env` file with real secrets.
#
# application.yml reads every one of these via ${VAR:default}, so anything
# left unset falls back to a development-only default - fine for local
# H2-backed dev, NOT fine for a real deployment.

# --- Spring profile ---------------------------------------------------------
# Leave unset (or blank) to use real MySQL by default (see below) - this is
# also what application.yml already falls back to on its own.
# "dev"  -> switches to an in-memory H2 database instead, demo data auto-seeded.
# "prod" -> production-hardened MySQL: disables auto-seeding, ddl-auto=validate.
SPRING_PROFILES_ACTIVE=

# --- Database (MySQL) -------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/caselock_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change-me
DDL_AUTO=update
SHOW_SQL=false

# --- JWT ---------------------------------------------------------------------
# Must be at least 256 bits (32+ characters) for HS256 signing. Generate one
# with: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-long-random-secret-value-before-deploying
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- File storage (evidence uploads) -----------------------------------------
FILE_STORAGE_PATH=./uploads
MAX_FILE_SIZE=50MB
MAX_REQUEST_SIZE=55MB
MAX_FILE_SIZE_MB=50

# --- CORS ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Server / logging ----------------------------------------------------------
SERVER_PORT=8080
LOG_LEVEL=INFO
LOG_FILE=logs/caselock.log
